<Window x:Class="BiSheng.Latte.Views.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BiSheng.Latte.Controls"
        Title="外观与样式设置"
        Height="640" Width="560" MinHeight="500" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.BgCanvas}">

    <!--
        跨窗口复用的资源（ValueDisplay、ColorSwatch、WindowFooterBorder 等）位于 WindowChromeStyles.xaml；
        这里只放本窗口布局页专用的卡片与示意图样式。
        卡片的 BorderBrush 由后台 UpdateLayoutCards 按当前选项设置（选中为强调色），此处只给未选中的默认值。
    -->
    <Window.Resources>
        <!-- 分节标题与说明 -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>

        <!-- 字号滑块：整数步进 -->
        <Style x:Key="SizeSlider" TargetType="Slider">
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- 可点击的选项卡片 -->
        <Style x:Key="LayoutCardBase" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
        </Style>
        <!-- 导航布局：横向大卡片（左示意图 + 右文字） -->
        <Style x:Key="LayoutModeCard" TargetType="Border" BasedOn="{StaticResource LayoutCardBase}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- 工具栏 / 状态栏：两列小卡片（上示意图 + 下文字） -->
        <Style x:Key="LayoutOptionCard" TargetType="Border" BasedOn="{StaticResource LayoutCardBase}">
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- 示意图外框 -->
        <Style x:Key="LayoutPreviewFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="LayoutModePreview" TargetType="Border" BasedOn="{StaticResource LayoutPreviewFrame}">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="LayoutOptionPreview" TargetType="Border" BasedOn="{StaticResource LayoutPreviewFrame}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- 示意图中的色块：透明度区分区域，在各处单独设置 -->
        <Style x:Key="PreviewBlock" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style x:Key="TreePreviewIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- 卡片文字 -->
        <Style x:Key="LayoutModeTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style x:Key="LayoutModeCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LayoutOptionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style x:Key="LayoutOptionCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 底部按钮栏 -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource WindowFooterBorder}">
            <StackPanel Margin="-8,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Click="OnExport"
                    Content="导出..."
                    Style="{StaticResource DialogButtonSecondary}" />
                <Button
                    Click="OnImport"
                    Content="导入..."
                    Style="{StaticResource DialogButtonSecondary}" />
                <Button
                    Click="OnCancel"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonNeutral}" />
                <Button
                    Click="OnApply"
                    Content="应用"
                    Style="{StaticResource DialogButtonSecondary}" />
                <Button
                    Click="OnSave"
                    Content="保存"
                    IsDefault="True"
                    Style="{StaticResource DialogButtonPrimary}" />
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <TabControl Padding="0" BorderThickness="0" Background="Transparent"
                    FontFamily="{StaticResource UIFont}" FontSize="13">
            <!-- 样式 Tab -->
            <TabItem Header="样式">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
                    <StackPanel x:Name="MainPanel">

                        <!-- ===== 主题选择 ===== -->
                        <TextBlock Text="主题" Style="{StaticResource SectionHeading}" Margin="0,0,0,6"/>
                        <TextBlock Text="选择预设或创建自定义主题，控制全局界面和编辑器的完整配色"
                                   Style="{StaticResource SectionDescription}" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="CreateCustomBtn" Content="复制并自定义"
                                    DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,0"
                                    Height="32" FontSize="12" FontWeight="SemiBold"
                                    Style="{StaticResource DialogButtonSecondary}"
                                    Click="OnCreateCustom"/>
                            <ComboBox x:Name="ThemeBox" Height="32" FontSize="13"
                                      SelectionChanged="OnThemeSelectionChanged"/>
                        </DockPanel>

                        <!-- 主题名称（仅自定义主题可编辑） -->
                        <DockPanel x:Name="CustomNamePanel" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="主题名:" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="DeleteThemeBtn" Content="删除" DockPanel.Dock="Right"
                                    Margin="8,0,0,0" Padding="10,0" Height="26" FontSize="11"
                                    Style="{StaticResource DialogButtonDanger}"
                                    Click="OnDeleteTheme"/>
                            <TextBox x:Name="ThemeNameBox" FontSize="13" Padding="6,4"
                                     TextChanged="OnThemeNameChanged"/>
                        </DockPanel>

                        <!-- ===== 界面配色 (Expander) ===== -->
                        <Expander x:Name="GlobalColorsExpander" Header="界面配色" IsExpanded="False"
                                  Visibility="Collapsed" Margin="0,0,0,8"
                                  Foreground="{DynamicResource Brush.Text}"
                                  FontFamily="{StaticResource UIFont}" FontSize="14"
                                  FontWeight="SemiBold">
                            <StackPanel x:Name="GlobalColorPanel" Margin="8,12,0,8"/>
                        </Expander>

                        <!-- ===== 编辑器配色 (Expander) ===== -->
                        <Expander x:Name="EditorColorsExpander" Header="编辑器配色" IsExpanded="False"
                                  Visibility="Collapsed" Margin="0,0,0,16"
                                  Foreground="{DynamicResource Brush.Text}"
                                  FontFamily="{StaticResource UIFont}" FontSize="14"
                                  FontWeight="SemiBold">
                            <StackPanel x:Name="EditorColorPanel" Margin="8,12,0,8"/>
                        </Expander>

                        <!-- 分割线 -->
                        <Border Height="1" Background="{DynamicResource Brush.BorderLight}"
                                Margin="0,0,0,20"/>

                        <!-- ===== 编辑器字体（按主题分别保存） ===== -->
                        <TextBlock Text="编辑器字体" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="FontThemeHint"
                                   Style="{StaticResource SectionDescription}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="为当前主题设置编辑器字体；切换主题时选项会跟着变化"/>
                        <ComboBox x:Name="FontFamilyBox" Height="32" FontSize="13"
                                  Margin="0,0,0,6"
                                  SelectionChanged="OnFontFamilySelectionChanged"/>
                        <TextBlock x:Name="FontAvailabilityHint"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   FontSize="12" Margin="0,0,0,20"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- ===== 行间距 ===== -->
                        <TextBlock Text="行间距" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="LineSpacingValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="LineSpacingSlider" Minimum="1.0" Maximum="2.5"
                                    Style="{StaticResource SizeSlider}" TickFrequency="0.1"
                                    ValueChanged="OnLineSpacingChanged"/>
                        </DockPanel>

                        <!-- ===== 正文字号 ===== -->
                        <TextBlock Text="正文字号" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,20">
                            <TextBlock x:Name="BodySizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="BodySizeSlider" Minimum="12" Maximum="24"
                                    Style="{StaticResource SizeSlider}"
                                    ValueChanged="OnBodySizeChanged"/>
                        </DockPanel>

                        <!-- 分割线 -->
                        <Border Height="1" Background="{DynamicResource Brush.BorderLight}"
                                Margin="0,4,0,20"/>

                        <TextBlock Text="标题字号" Foreground="{DynamicResource Brush.Text}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <!-- 一级标题 -->
                        <TextBlock Text="一级标题 (H1)" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="H1SizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="H1SizeSlider" Minimum="20" Maximum="48"
                                    Style="{StaticResource SizeSlider}" ValueChanged="OnH1Changed"/>
                        </DockPanel>

                        <!-- 二级标题 -->
                        <TextBlock Text="二级标题 (H2)" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="H2SizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="H2SizeSlider" Minimum="16" Maximum="40"
                                    Style="{StaticResource SizeSlider}" ValueChanged="OnH2Changed"/>
                        </DockPanel>

                        <!-- 三级标题 -->
                        <TextBlock Text="三级标题 (H3)" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="H3SizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="H3SizeSlider" Minimum="14" Maximum="36"
                                    Style="{StaticResource SizeSlider}" ValueChanged="OnH3Changed"/>
                        </DockPanel>

                        <!-- 四级标题 -->
                        <TextBlock Text="四级标题 (H4)" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="H4SizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="H4SizeSlider" Minimum="12" Maximum="28"
                                    Style="{StaticResource SizeSlider}" ValueChanged="OnH4Changed"/>
                        </DockPanel>

                        <!-- 五级标题 -->
                        <TextBlock Text="五级标题 (H5)" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="H5SizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="H5SizeSlider" Minimum="12" Maximum="24"
                                    Style="{StaticResource SizeSlider}" ValueChanged="OnH5Changed"/>
                        </DockPanel>

                        <!-- 六级标题 -->
                        <TextBlock Text="六级标题 (H6)" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock x:Name="H6SizeValue" Style="{StaticResource ValueDisplay}"
                                       DockPanel.Dock="Right"/>
                            <Slider x:Name="H6SizeSlider" Minimum="12" Maximum="20"
                                    Style="{StaticResource SizeSlider}" ValueChanged="OnH6Changed"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 布局 Tab -->
            <TabItem Header="布局">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
                    <StackPanel>
                        <!-- ===== 导航区布局 ===== -->
                        <TextBlock Text="导航区布局" Style="{StaticResource SectionHeading}" Margin="0,0,0,6"/>
                        <TextBlock Text="选择文件夹与笔记的展示方式"
                                   Style="{StaticResource SectionDescription}" Margin="0,0,0,16"/>

                        <!-- 并列模式卡片 -->
                        <Border x:Name="SideBySideCard" Style="{StaticResource LayoutModeCard}"
                                MouseLeftButtonDown="OnSideBySideSelected">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LayoutModePreview}">
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource PreviewBlock}" Opacity="0.25"/>
                                        <Border Grid.Column="1" Background="{DynamicResource Brush.Border}"
                                                CornerRadius="1"/>
                                        <Border Grid.Column="2" Style="{StaticResource PreviewBlock}" Opacity="0.15"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="左右并列" Style="{StaticResource LayoutModeTitle}"/>
                                    <TextBlock Text="文件夹树与笔记列表分列并排展示"
                                               Style="{StaticResource LayoutModeCaption}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 归纳模式卡片 -->
                        <Border x:Name="TreeViewCard" Style="{StaticResource LayoutModeCard}"
                                MouseLeftButtonDown="OnTreeViewSelected">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LayoutModePreview}">
                                    <StackPanel Margin="8,6">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="📁" Style="{StaticResource TreePreviewIcon}"/>
                                            <Border Style="{StaticResource PreviewBlock}" Opacity="0.25"
                                                    Height="8" Width="40"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,2">
                                            <TextBlock Text="📄" Style="{StaticResource TreePreviewIcon}"/>
                                            <Border Style="{StaticResource PreviewBlock}" Opacity="0.15"
                                                    Height="8" Width="32"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,2">
                                            <TextBlock Text="📄" Style="{StaticResource TreePreviewIcon}"/>
                                            <Border Style="{StaticResource PreviewBlock}" Opacity="0.15"
                                                    Height="8" Width="36"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="📁" Style="{StaticResource TreePreviewIcon}"/>
                                            <Border Style="{StaticResource PreviewBlock}" Opacity="0.25"
                                                    Height="8" Width="36"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="树形归纳" Style="{StaticResource LayoutModeTitle}"/>
                                    <TextBlock Text="笔记作为叶节点归纳到文件夹树中"
                                               Style="{StaticResource LayoutModeCaption}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== 工具栏：上行选位置，下行选显示方式 ===== -->
                        <TextBlock Text="工具栏" Style="{StaticResource SectionHeading}" Margin="0,8,0,6"/>
                        <TextBlock Text="位置与显示方式，上方选位置、下方选显示"
                                   Style="{StaticResource SectionDescription}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 顶部横条 -->
                            <Border x:Name="ToolbarTopCard" Grid.Row="0" Grid.Column="0" Margin="0,0,4,4"
                                    Style="{StaticResource LayoutOptionCard}"
                                    MouseLeftButtonDown="OnToolbarTopSelected">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource LayoutOptionPreview}">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource PreviewBlock}" Opacity="0.35" />
                                            <Border Grid.Row="1" Margin="0,3,0,0"
                                                    Style="{StaticResource PreviewBlock}" Opacity="0.12" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="顶部横条" Style="{StaticResource LayoutOptionTitle}" />
                                    <TextBlock Text="宽屏横条" Style="{StaticResource LayoutOptionCaption}" />
                                </StackPanel>
                            </Border>

                            <!-- 导航左侧 -->
                            <Border x:Name="ToolbarNavLeftCard" Grid.Row="0" Grid.Column="1" Margin="4,0,0,4"
                                    Style="{StaticResource LayoutOptionCard}"
                                    MouseLeftButtonDown="OnToolbarNavLeftSelected">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource LayoutOptionPreview}">
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource PreviewBlock}" Opacity="0.35" />
                                            <Border Grid.Column="1" Margin="3,0,0,0"
                                                    Style="{StaticResource PreviewBlock}" Opacity="0.12" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="导航左侧" Style="{StaticResource LayoutOptionTitle}" />
                                    <TextBlock Text="纵向竖条" Style="{StaticResource LayoutOptionCaption}" />
                                </StackPanel>
                            </Border>

                            <!-- 固定显示 -->
                            <Border x:Name="ToolbarFixedCard" Grid.Row="1" Grid.Column="0" Margin="0,4,4,0"
                                    Style="{StaticResource LayoutOptionCard}"
                                    MouseLeftButtonDown="OnToolbarFixedSelected">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource LayoutOptionPreview}">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource PreviewBlock}" Opacity="0.55" />
                                            <Border Grid.Row="1" Margin="0,3,0,0"
                                                    Style="{StaticResource PreviewBlock}" Opacity="0.12" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="固定显示" Style="{StaticResource LayoutOptionTitle}" />
                                    <TextBlock Text="始终可见" Style="{StaticResource LayoutOptionCaption}" />
                                </StackPanel>
                            </Border>

                            <!-- 悬停淡入淡出 -->
                            <Border x:Name="ToolbarAutoHideCard" Grid.Row="1" Grid.Column="1" Margin="4,4,0,0"
                                    Style="{StaticResource LayoutOptionCard}"
                                    MouseLeftButtonDown="OnToolbarAutoHideSelected">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource LayoutOptionPreview}">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource PreviewBlock}" Opacity="0.15" />
                                            <Border Grid.Row="1" Margin="0,3,0,0"
                                                    Style="{StaticResource PreviewBlock}" Opacity="0.12" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="悬停淡入淡出" Style="{StaticResource LayoutOptionTitle}" />
                                    <TextBlock Text="移入显示" Style="{StaticResource LayoutOptionCaption}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== 状态栏 ===== -->
                        <TextBlock Text="状态栏" Style="{StaticResource SectionHeading}" Margin="0,20,0,6"/>
                        <TextBlock Text="底部同步状态栏的显示方式。隐藏后连接状态仍在工具栏徽章中显示。"
                                   Style="{StaticResource SectionDescription}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 固定显示 -->
                            <Border x:Name="StatusBarFixedCard" Grid.Column="0" Margin="0,0,4,0"
                                    Style="{StaticResource LayoutOptionCard}"
                                    MouseLeftButtonDown="OnStatusBarFixedSelected">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource LayoutOptionPreview}">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="8" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource PreviewBlock}" Opacity="0.12" />
                                            <Border Grid.Row="1" Style="{StaticResource PreviewBlock}" Opacity="0.55" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="固定显示" Style="{StaticResource LayoutOptionTitle}" />
                                    <TextBlock Text="始终可见" Style="{StaticResource LayoutOptionCaption}" />
                                </StackPanel>
                            </Border>

                            <!-- 隐藏 -->
                            <Border x:Name="StatusBarHiddenCard" Grid.Column="1" Margin="4,0,0,0"
                                    Style="{StaticResource LayoutOptionCard}"
                                    MouseLeftButtonDown="OnStatusBarHiddenSelected">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Style="{StaticResource LayoutOptionPreview}">
                                        <Border Margin="5" Style="{StaticResource PreviewBlock}" Opacity="0.12" />
                                    </Border>
                                    <TextBlock Text="隐藏" Style="{StaticResource LayoutOptionTitle}" />
                                    <TextBlock Text="隐藏底栏（连接状态仍在工具栏）"
                                               Style="{StaticResource LayoutOptionCaption}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== 窗口与托盘 ===== -->
                        <TextBlock Text="窗口与托盘" Style="{StaticResource SectionHeading}" Margin="0,20,0,6"/>
                        <TextBlock Text="关闭主窗口时的行为。取消勾选后，关闭按钮将直接退出应用。"
                                   Style="{StaticResource SectionDescription}" Margin="0,0,0,12"/>
                        <CheckBox
                            x:Name="CloseToTrayBox"
                            Content="关闭窗口时最小化到系统托盘"
                            Checked="OnCloseToTrayChanged"
                            Unchecked="OnCloseToTrayChanged" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
