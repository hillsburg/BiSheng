<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 方框和对勾按正文字号同比例缩放；模板只负责外观，交互由 CheckBox 处理。 -->
    <ControlTemplate x:Key="TaskCheckBoxTemplate" TargetType="{x:Type CheckBox}">
        <Grid x:Name="HitArea" Background="Transparent">
            <Viewbox IsHitTestVisible="False">
                <Grid Width="16" Height="16">
                    <Border
                        x:Name="Box"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="3" />
                    <Path
                        x:Name="CheckMark"
                        Data="M 4,8 L 7,11 L 12,5.5"
                        Stroke="White"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.8"
                        Visibility="Hidden" />
                </Grid>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HitArea" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HitArea" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
